<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ServerFixes</AssemblyName>
    <RootNamespace>ServerFixes</RootNamespace>
    <Version>1.1.0</Version>
    <!-- Plugin loads into the running TShock server process; never emit the TShock/OTAPI
         assemblies into our output, only our own plugin DLL. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ServerFixes.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- compile only: the server process already hosts TShock/OTAPI and its content assets
         (e.g. HttpServer.dll), so we neither copy runtime assemblies nor content files.
         Pinned to the exact build the fixes were written against; see README before bumping. -->
    <PackageReference Include="TShock" Version="6.2.1">
      <ExcludeAssets>runtime;contentFiles</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Optional: drop the built plugin into a local server for testing.
       Set ServerPluginsPath (e.g. dotnet build -p:ServerPluginsPath=C:\TShock\ServerPlugins). -->
  <Target Name="CopyToServerPlugins" AfterTargets="Build" Condition="'$(ServerPluginsPath)' != ''">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ServerPluginsPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>
